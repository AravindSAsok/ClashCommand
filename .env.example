# Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clash_command"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# First admin account (created on the first successful login)
ADMIN_EMAIL="admin@clashcommand.local"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional Clash of Clans API key (never commit a real key)
COC_API_KEY=""
